{
  "name": "automation-excercise",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:web": "npx cucumber-js --config tests/support/cucumber.js --tags '@web'",
    "test:web:chromium": "dotenv run -f .env.chromium -- npm run test:web",
    "test:web:firefox": "dotenv run -f .env.firefox -- npm run test:web",
    "test:web:webkit": "dotenv run -f .env.webkit -- npm run test:web",
    "test:web:all": "npm-run-all test:web:chromium test:web:firefox test:web:webkit",
    "test:web:chromium:report": "npm-run-all -s -c test:web:chromium report:chromium",
    "test:web:firefox:report": "npm-run-all -s -c test:web:firefox report:firefox",
    "test:web:webkit:report": "npm-run-all -s -c test:web:webkit report:webkit",
    "test:web:all:report": "npm-run-all test:web:chromium:report test:web:firefox:report test:web:webkit:report",
    "test:weblogin": "npx cucumber-js --config tests/support/cucumber.js --tags '@weblogin'",
    "test:weblogin:chromium": "dotenv run -f .env.chromium -- npm run test:weblogin",
    "test:weblogin:firefox": "dotenv run -f .env.firefox -- npm run test:weblogin",
    "test:weblogin:webkit": "dotenv run -f .env.webkit -- npm run test:weblogin",
    "test:weblogin:all": "npm-run-all test:weblogin:chromium test:weblogin:firefox test:weblogin:webkit",
    "test:weblogin:chromium:report": "npm-run-all -s -c test:weblogin:chromium report:chromium",
    "test:weblogin:firefox:report": "npm-run-all -s -c test:weblogin:firefox report:firefox",
    "test:weblogin:webkit:report": "npm-run-all -s -c test:weblogin:webkit report:webkit",
    "test:weblogin:all:report": "npm-run-all test:weblogin:chromium:report test:weblogin:firefox:report test:weblogin:webkit:report",
    "report:chromium": "dotenv run -f .env.chromium -- node tests/support/generateReport.js",
    "report:firefox": "dotenv run -f .env.firefox -- node tests/support/generateReport.js",
    "report:webkit": "dotenv run -f .env.webkit -- node tests/support/generateReport.js",
    "serve:report": "xdg-open reports/html-chromium/index.html || open reports/html-chromium/index.html",
    "test:weblogin:chromium:report:Headed": "HEADLESS=false npm-run-all -s -c test:weblogin:chromium report:chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "dotenv-cli": "^11.0.0",
    "fs-extra": "^11.4.1",
    "multiple-cucumber-html-reporter": "^4.3.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
{
  "name": "automation-excercise",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx cucumber-js --config tests/support/cucumber.js",
    "test:tag": "dotenv run -f .env.chromium -- npx cucumber-js --config tests/support/cucumber.js --tags",
    "report:generate": "dotenv run -f .env.chromium -- node tests/support/generateReport.js",
    "test:smoke": "npm run test:tag -- '@smoke'",
    "test:sanity": "npm run test:tag -- '@sanity'",
    "test:regression": "npm run test:tag -- '@regression'",
    "test:all": "npm run test:tag -- '@web'",
    "test:smoke:report": "npm-run-all -s -c test:smoke report:generate",
    "test:sanity:report": "npm-run-all -s -c test:sanity report:generate",
    "test:regression:report": "npm-run-all -s -c test:regression report:generate",
    "test:all:report": "npm-run-all -s -c test:all report:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "dotenv-cli": "^11.0.0",
    "fs-extra": "^11.4.1",
    "multiple-cucumber-html-reporter": "^4.3.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
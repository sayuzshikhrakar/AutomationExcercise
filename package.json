{
  "name": "automation-excercise",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:tag": "npx cucumber-js --config tests/support/cucumber.js --parallel 3 --tags",
    "test:chrome": "dotenv run -f .env.chromium -- npm run test:tag --",
    "test:firefox": "dotenv run -f .env.firefox -- npm run test:tag --",
    "test:all-browsers": "npm-run-all -c -s \"test:chrome -- {@}\" \"test:firefox -- {@}\" --",
    "report:generate": "node tests/support/generateReport.js",
    "test:smoke": "npm run test:all-browsers -- '@smoke'",
    "test:sanity": "npm run test:all-browsers -- '@sanity'",
    "test:regression": "npm run test:all-browsers -- '@regression'",
    "test:all": "npm run test:all-browsers -- '@web'",
    "test:smoke:report": "npm-run-all -c -s test:smoke report:generate",
    "test:sanity:report": "npm-run-all -c -s test:sanity report:generate",
    "test:regression:report": "npm-run-all -c -s test:regression report:generate",
    "test:all:report": "npm-run-all -c -s test:all report:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.3",
    "dotenv-cli": "^11.0.0",
    "fs-extra": "^11.4.1",
    "multiple-cucumber-html-reporter": "^4.3.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}